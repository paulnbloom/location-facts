# OpenTripMap API Key
# Get yours at: https://opentripmap.io/product
VITE_OPENTRIPMAP_API_KEY=

# Yelp Fusion API Key
# Get yours at: https://www.yelp.com/developers
VITE_YELP_API_KEY=

# Ticketmaster Discovery API Key
# Get yours at: https://developer.ticketmaster.com/
VITE_TICKETMASTER_API_KEY=

# CORS Proxy Base URL (optional)
# For accessing CORS-blocked sources like CIA Factbook and State Dept
# Example: https://your-cors-proxy.com or https://cors-anywhere.herokuapp.com
VITE_PROXY_BASE_URL=
